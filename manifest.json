{
  "manifest_version": 3,
  "name": "Odoo Chatter Utilities",
  "version": "2.0.4",
  "description": "Take control of Odoo chatter — hide, resize & act in one click. Pins, debug mode & recents. Free & private.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": ["*://*.odoo.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.odoo.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["support.css", "popup.css", "styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-chatter": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Command+Shift+X"
      },
      "description": "Toggle Chatter Panel"
    }
  }
} 